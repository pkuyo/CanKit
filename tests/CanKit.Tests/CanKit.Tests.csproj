<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AssemblyName>CanKit.Tests</AssemblyName>
    <RootNamespace>CanKit.Tests</RootNamespace>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks Condition="'$(Configuration)' == 'Fake'">true</AllowUnsafeBlocks>
    <DefineConstants Condition="'$(Configuration)' == 'Fake'">$(DefineConstants);FAKE</DefineConstants>
    <!-- net48 is kept on purpose for Windows hardware tests against .NET Framework. -->
    <TargetFrameworks>net8.0;net10.0;net48</TargetFrameworks>
    <Configurations>Debug;Release;Fake</Configurations>
    <Platforms>AnyCPU;X86;X64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- FluentAssertions v8+ is commercial (Xceed) for commercial use; stay on the last 7.x OSS line. -->
    <PackageReference Include="FluentAssertions" Version="[7.2.2,8.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\core\CanKit.Core\CanKit.Core.csproj" />
    <ProjectReference Include="..\..\src\adapters\CanKit.Adapter.ControlCAN\CanKit.Adapter.ControlCAN.csproj" />
    <ProjectReference Include="..\..\src\adapters\CanKit.Adapter.Vector\CanKit.Adapter.Vector.csproj" />
    <ProjectReference Include="..\..\src\adapters\CanKit.Adapter.Virtual\CanKit.Adapter.Virtual.csproj" />
    <ProjectReference Include="..\..\src\adapters\CanKit.Adapter.SocketCAN\CanKit.Adapter.SocketCAN.csproj" />
    <ProjectReference Include="..\..\src\adapters\CanKit.Adapter.PCAN\CanKit.Adapter.PCAN.csproj" />
    <ProjectReference Include="..\..\src\adapters\CanKit.Adapter.Kvaser\CanKit.Adapter.Kvaser.csproj" />
    <ProjectReference Include="..\..\src\adapters\CanKit.Adapter.ZLG\CanKit.Adapter.ZLG.csproj" />
  </ItemGroup>
</Project>

