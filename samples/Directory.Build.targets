<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CanKitRegistrationsGenerated>$(IntermediateOutputPath)CanKit.Registrations.g.cs</CanKitRegistrationsGenerated>
  </PropertyGroup>

  <!-- ProjectReference builds do not import NuGet buildTransitive assets. Generate the
       same static registration calls for the repository samples from resolved references. -->
  <Target Name="CanKit_Samples_GenerateStaticRegistrations"
          AfterTargets="ResolveReferences"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <_CanKitComponentDllCandidates Include="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('CanKit.Adapter.', System.StringComparison.Ordinal)) Or $([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('CanKit.Transport.', System.StringComparison.Ordinal))" />
      <CanKitRegistrationType Include="@(_CanKitComponentDllCandidates-&gt;'%(Filename).CanKitRegistration')" />
      <_CanKitRegistrationTypes Remove="@(_CanKitRegistrationTypes)" />
      <_CanKitRegistrationLines Remove="@(_CanKitRegistrationLines)" />
      <_CanKitRegistrationCalls Remove="@(_CanKitRegistrationCalls)" />
    </ItemGroup>

    <RemoveDuplicates Inputs="@(CanKitRegistrationType)">
      <Output TaskParameter="Filtered" ItemName="_CanKitRegistrationTypes" />
    </RemoveDuplicates>

    <ItemGroup Condition=" '@(_CanKitRegistrationTypes)' != '' ">
      <_CanKitRegistrationLines Include="// &lt;auto-generated /&gt;" />
      <_CanKitRegistrationLines Include="namespace CanKit.Core.Internal {" />
      <_CanKitRegistrationLines Include="    internal static class CanKitModuleInitializer {" />
      <_CanKitRegistrationLines Include="        [global::System.Runtime.CompilerServices.ModuleInitializer]" />
      <_CanKitRegistrationLines Include="        internal static void Initialize() {" />
      <_CanKitRegistrationCalls Include="@(_CanKitRegistrationTypes-&gt;'            global::%(Identity).Register()%3B')" />
      <_CanKitRegistrationLines Include="@(_CanKitRegistrationCalls)" />
      <_CanKitRegistrationLines Include="        }" />
      <_CanKitRegistrationLines Include="    }" />
      <_CanKitRegistrationLines Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(CanKitRegistrationsGenerated)"
                      Lines="@(_CanKitRegistrationLines)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Encoding="UTF-8"
                      Condition=" '@(_CanKitRegistrationTypes)' != '' " />

    <ItemGroup Condition=" '@(_CanKitRegistrationTypes)' != '' ">
      <Compile Include="$(CanKitRegistrationsGenerated)" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
