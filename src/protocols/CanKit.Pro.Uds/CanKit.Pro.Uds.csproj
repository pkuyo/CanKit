<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <LangVersion>12</LangVersion>
        <RootNamespace>CanKit.Pro.Uds</RootNamespace>
        <AssemblyName>CanKit.Pro.Uds</AssemblyName>
        <Version>$(CanKitProUdsVersion)</Version>
        <Description>Experimental Unified Diagnostic Services (ISO 14229-1) client for CanKit.Pro. Provides an async IUdsClient over IIsoTpChannel with the MVP service set (0x10 DiagnosticSessionControl, 0x11 ECUReset, 0x22 ReadDataByIdentifier, 0x27 SecurityAccess, 0x2E WriteDataByIdentifier, 0x31 RoutineControl, 0x3E TesterPresent), P2/P2* timing, NRC 0x78 responsePending handling and structured negative-response reporting.</Description>
        <PackageTags>CAN;can bus;CANFD;UDS;ISO 14229;diagnostics;CanKit;CanKit.Pro</PackageTags>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>$(CanKitSharedFileVersion)</FileVersion>
        <Authors>Pkuyo</Authors>
        <RepositoryUrl>https://github.com/dborgards/CanKit.Pro</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Configurations>Debug;Release;Fake</Configurations>
        <Platforms>AnyCPU</Platforms>
        <!-- Full client incl. multi-DID, upload/download and NRC 0x78 handling (0.1.x); still pre-release. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
        <PackageReference Include="System.Memory" Version="4.5.4" />
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.10" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)'=='true'">
        <ProjectReference Include="..\..\core\CanKit.Abstractions\CanKit.Abstractions.csproj" />
        <ProjectReference Include="..\..\core\CanKit.Core\CanKit.Core.csproj" />
        <ProjectReference Include="..\..\core\CanKit.Pro.Actor\CanKit.Pro.Actor.csproj" />
        <ProjectReference Include="..\..\core\CanKit.Pro.RawCan\CanKit.Pro.RawCan.csproj" />
        <ProjectReference Include="..\..\core\CanKit.Pro.Reliability\CanKit.Pro.Reliability.csproj" />
        <ProjectReference Include="..\..\transports\CanKit.Pro.IsoTp\CanKit.Pro.IsoTp.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)'!='true'">
        <PackageReference Include="CanKit.Abstractions" Version="$(CanKitAbstractionsDependencyVersion)" />
        <PackageReference Include="CanKit.Core" Version="$(CanKitCoreDependencyVersion)" />
        <PackageReference Include="CanKit.Pro.Actor" Version="$(CanKitProActorVersion)" />
        <PackageReference Include="CanKit.Pro.RawCan" Version="$(CanKitProRawCanVersion)" />
        <PackageReference Include="CanKit.Pro.Reliability" Version="$(CanKitProReliabilityVersion)" />
        <PackageReference Include="CanKit.Pro.IsoTp" Version="$(CanKitProIsoTpVersion)" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>
</Project>
