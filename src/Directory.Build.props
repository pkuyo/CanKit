<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\eng\package-versions.props" />

  <PropertyGroup>
    <!-- net8.0 is kept until its EOL (November 2026). net10.0 is the current LTS. -->
    <TargetFrameworks>netstandard2.0;net8.0;net8.0-windows;net10.0;net10.0-windows</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Nullable>enable</Nullable>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <UseLocalProjectReferences Condition="'$(UseLocalProjectReferences)'==''">true</UseLocalProjectReferences>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <CanKitRepositoryRoot>$([MSBuild]::EnsureTrailingSlash($([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), 'CanKit.sln'))))</CanKitRepositoryRoot>
    <PackageOutputPath>$(CanKitRepositoryRoot)artifacts\nuget</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Fake'">
    <DefineConstants>$(DefineConstants);FAKE</DefineConstants>
  </PropertyGroup>
</Project>
